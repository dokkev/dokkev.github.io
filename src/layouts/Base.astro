---
import "../styles/global.css";
import "katex/dist/katex.min.css";
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  article?: boolean;
}
const {
  title = "Dong Ho Kang",
  description = "Robotics researcher at UT Austin. Contact Morphology Design, dexterous manipulation, and robot control.",
  lang = "en",
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  ["/", "About"],
  ["/publications/", "Publications"],
  ["/projects/", "Projects"],
  ["/blog/", "Blog"],
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Dong Ho Kang' ? title : `${title} · Dong Ho Kang`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/img/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/assets/img/prof_pic.jpg", Astro.site)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": article ? "BlogPosting" : "WebPage",
        name: title,
        description,
        url: canonical,
        ...(article ? { author: { "@type": "Person", name: "Dong Ho Kang", url: Astro.site } } : {}),
      }).replaceAll("<", "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/">
          Dong Ho Kang<span class="wordmark-dot">.</span>
        </a>
        <nav aria-label="Main navigation">
          {links.map(([url, label]) => (
            <a href={url} aria-current={(url === "/" ? current === "/" : current.startsWith(url)) ? "page" : undefined}>
              {label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          Dong Ho Kang <span>·</span> Robotics, contact, and design.
        </p>
        <div>
          <a href="mailto:dongho.robot@gmail.com">Email ↗</a>
          <a href="https://github.com/dokkev">GitHub ↗</a>
        </div>
      </footer>
    </div>
  </body>
</html>
