---
import Base from "../layouts/Base.astro";
import Publication from "../components/Publication.astro";
import { publications } from "../lib/publications";
const years = [...new Set(publications.map((p: any) => p.issued?.["date-parts"]?.[0]?.[0]))].sort((a: any, b: any) => b - a);
---

<Base title="Publications" description="Research publications by Dong Ho Kang in contact morphology, dexterous manipulation, and robot control.">
  <header class="page-heading">
    <p class="eyebrow">Research</p>
    <h1>Publications</h1>
    <p>Peer-reviewed publications, workshop papers, and preprints.</p>
  </header>
  {years.map((year) => (
    <section class="publication-year">
      <h2>{year}</h2>
      <div class="publication-list">
        {publications
          .filter((p: any) => p.issued?.["date-parts"]?.[0]?.[0] === year)
          .map((paper: any) => (
            <Publication paper={paper} />
          ))}
      </div>
    </section>
  ))}
  <section class="home-section">
    <div class="section-heading">
      <h2>Media coverage</h2>
    </div>
    <div class="media-list">
      <a href="https://spectrum.ieee.org/video-friday-rabona-soccer">ARISTO · IEEE Spectrum ↗</a>
      <a href="https://www.sciencenews.org/article/robots-fingernails-grasp-thin-edges">PLATO · Science News ↗</a>
    </div>
  </section>
</Base>
