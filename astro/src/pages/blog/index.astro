---
import Base from "../../layouts/Base.astro";
import { listedPosts, posts, seriesNames } from "../../lib/content";
---

<Base title="Blog" description="Notes on robotics, contact morphology, whole-body control, and building robot hardware.">
  <header class="page-heading">
    <p class="eyebrow">Research notebook</p>
    <h1>Ideas, explained.</h1>
    <p>Notes on designing, building, and controlling robots.</p>
  </header>
  <a class="demo-feature" href="/blog/contact-response/">
    <div>
      <p class="eyebrow">Interactive example</p>
      <h2>A spring at the contact interface</h2>
      <p>Adjust stiffness and indentation. See how a simple contact model responds.</p>
      <span>Explore the demo →</span>
    </div>
    <div class="demo-thumbnail" aria-hidden="true">
      <span class="demo-line"></span>
      <span class="demo-dot"></span>
      <span>F = kδ</span>
    </div>
  </a>
  <div class="blog-layout">
    <section>
      <h2 class="list-heading">Latest articles</h2>
      <div class="article-list">
        {listedPosts.map((post) => (
          <article>
            <p class="eyebrow">
              {post.date}
              {post.series ? ` · ${post.series}` : ""}
            </p>
            <h3>
              <a href={post.url}>{post.title}</a>
            </h3>
            <p>{post.description}</p>
            <a class="text-link" href={post.url}>
              Read article ↗
            </a>
          </article>
        ))}
      </div>
    </section>
    <aside class="series-sidebar">
      <h2>Series</h2>
      {seriesNames.map((name) => (
        <details open>
          <summary>{name}</summary>
          <ol>
            {posts
              .filter((p) => p.series === name && p.lang !== "ko")
              .sort((a, b) => a.seriesOrder - b.seriesOrder)
              .map((post) => (
                <li>
                  <a href={post.url}>{post.title.replace(/^\[[^\]]+\]\s*-?\s*/, "")}</a>
                </li>
              ))}
          </ol>
        </details>
      ))}
    </aside>
  </div>
</Base>
